+def current_horizon_vol_series(df: pd.DataFrame, horizon: int, cfg: Config) -> pd.Series:
+    """Causal current-horizon volatility for label scaling.
+
+    핵심 원칙:
+    - future return 라벨의 threshold를 종목별/시점별 변동성에 맞춘다.
+    - rolling std에는 현재 시점 이전 수익률만 사용하기 위해 shift(1)을 적용한다.
+    - volatility-scaled threshold가 지나치게 작거나 커지는 것을 min/max absolute threshold로 제한한다.
+    """
+    if "daily_return" in df.columns:
+        r = df["daily_return"].astype(float)
+    elif "Close" in df.columns:
+        r = df["Close"].astype(float).pct_change()
+    else:
+        raise KeyError("current_horizon_vol_series requires daily_return or Close")
+
+    vol_window = int(getattr(cfg, "direction_vol_window", 60))
+    vol = r.rolling(vol_window, min_periods=max(20, vol_window // 2)).std().shift(1)
+    hv = vol * math.sqrt(max(int(horizon), 1))
+    return hv.replace([np.inf, -np.inf], np.nan)
+
+
+def direction_threshold_series(df: pd.DataFrame, horizon: int, cfg: Config) -> pd.Series:
+    """Return per-row absolute direction threshold.
+
+    Modes:
+    - fixed: legacy fixed ±direction_return_threshold
+    - vol_scaled: k × current_horizon_vol with absolute floor/cap
+    """
+    mode = str(getattr(cfg, "direction_label_mode", "vol_scaled")).lower()
+    idx = df.index
+    fixed_thr = float(getattr(cfg, "direction_return_threshold", 0.005))
+    if mode == "fixed":
+        return pd.Series(fixed_thr, index=idx, dtype=float)
+    if mode != "vol_scaled":
+        raise ValueError(f"unknown direction_label_mode: {mode}")
+
+    k = float(getattr(cfg, "direction_vol_k", 0.30))
+    min_abs = float(getattr(cfg, "direction_min_abs_threshold", 0.003))
+    max_abs = float(getattr(cfg, "direction_max_abs_threshold", 0.040))
+    hv = current_horizon_vol_series(df, horizon, cfg)
+    thr = (k * hv).clip(lower=min_abs, upper=max_abs)
+    return thr.fillna(fixed_thr).astype(float)
+
+
+def add_direction_threshold_columns(df: pd.DataFrame, cfg: Config) -> pd.DataFrame:
+    """Attach diagnostic threshold columns for each horizon.
+
+    These columns are not model features. They are label/diagnostic columns only.
+    """
+    out = df.copy()
+    for h in getattr(cfg, "horizons", (5, 10, 20)):
+        h = int(h)
+        out[f"direction_threshold_{h}d"] = direction_threshold_series(out, h, cfg)
+        out[f"direction_current_horizon_vol_{h}d"] = current_horizon_vol_series(out, h, cfg)
+    return out
+
